# Add these to Server/.env alongside the existing database/auth settings.
# On Render, use a combined Node Web Service; see DEPLOYMENT.md at repo root.
# NODE_ENV=production
# SERVE_CLIENT=true
# FRONTEND_URL=https://sielalumnilink.onrender.com
# COOKIE_SAME_SITE=lax
# Keep these on the SERVER only; never add them as VITE_* variables.
# Brevo HTTPS API works on Render Free; verify this sender in Brevo first.
# EMAIL_PROVIDER=brevo
# EMAIL_USER=<verified Brevo sender email>
# BREVO_API_KEY=<Brevo API key, not SMTP key>
# Optional local SMTP: EMAIL_PROVIDER=smtp, EMAIL_USER, EMAIL_PASS.
# Render Free blocks outbound Gmail SMTP ports 465/587.
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
