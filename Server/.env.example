# Add these to Server/.env alongside the existing database/auth settings.
# On Render, use a combined Node Web Service; see DEPLOYMENT.md at repo root.
# NODE_ENV=production
# SERVE_CLIENT=true
# FRONTEND_URL=https://sielalumnilink.onrender.com
# COOKIE_SAME_SITE=lax
# Render Free blocks Gmail SMTP. Use Gmail HTTPS; see Server/GMAIL_SETUP.md.
# Keep these on the SERVER only; never add them as VITE_* variables.
# EMAIL_PROVIDER=gmail_api
# EMAIL_USER=<authorized Gmail sender>
# GOOGLE_CLIENT_ID=<Google OAuth client ID>
# GOOGLE_CLIENT_SECRET=<server-only client secret>
# GOOGLE_REFRESH_TOKEN=<saved by npm run setup:gmail>
# Optional alternative if you own a verified sending domain:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=<server-only sending API key>
# EMAIL_FROM=AlumniLink <login@your-verified-domain.example>
# Paid hosting/local Gmail alternative:
# EMAIL_PROVIDER=smtp
# EMAIL_USER=<gmail address>
# EMAIL_PASS=<new Gmail app password>
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
