# Add these to Server/.env alongside the existing database/auth settings.
# On Render, use a combined Node Web Service; see DEPLOYMENT.md at repo root.
# NODE_ENV=production
# SERVE_CLIENT=true
# FRONTEND_URL=https://sielalumnilink.onrender.com
# COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
